# Copy this file to .env and fill in the values below.
# .env is git-ignored, so your secrets stay local.

# ─── Network ──────────────────────────────────────────────────────────────
# Choose: "main" (mainnet) or "test" (testnet). Default: test.
APEX_ENV=test

# ─── Ethereum key (required for register / on-chain demos) ────────────────
# Hex-encoded private key of the Ethereum wallet you want to use.
ETH_PRIVATE_KEY=

# ─── API credentials (required for private demos after registration) ──────
# Run tests/01_register_v3.py once to obtain these. The output prints the
# apiKey block — copy the three values here.
APEX_API_KEY=
APEX_API_SECRET=
APEX_API_PASSPHRASE=

# ─── ZK keys (required for order placement / signing demos) ───────────────
# Returned by `client.derive_zk_key(...)` during registration.
APEX_ZK_SEEDS=
APEX_ZK_L2KEY=
# Only needed for the LP/mul-address activation demo (08_*).
APEX_ZK_PUBKEY_HASH=

# ─── Multi-address (LP) registration (optional, only for 07_/08_) ─────────
APEX_MUL_ETH_ADDRESS=

# ─── RWA credentials (optional, only for RWA demos) ───────────────────────
APEX_RWA_API_KEY=
APEX_RWA_API_SECRET=
APEX_RWA_API_PASSPHRASE=

# ─── Transfer demos (optional) ────────────────────────────────────────────
RECEIVER_ETH_ADDRESS=
RECEIVER_ACCOUNT_ID=
RECEIVER_ZK_ACCOUNT_ID=
